# Echidna Configuration
PORT=3000

# API Keys (optional but recommended for better rate limits)
# Get free keys from:
# Ethereum: https://www.alchemy.com/ or https://infura.io/
# Bitcoin: https://www.blockcypher.com/
ALCHEMY_API_KEY=your_alchemy_key_here
BLOCKCYPHER_TOKEN=your_blockcypher_token_here

# Supabase (optional - will use local storage if not provided)
# Get free account: https://supabase.com/
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Notification Settings (optional)
# Discord or Slack webhook URL
WEBHOOK_URL=your_discord_or_slack_webhook_url
